# --- PustakaMitra AI backend configuration (copy to .env and fill in) ---
# All values are server-side only; never put these in frontend code.

# MongoDB. Tests use MONGO_URI with database pustakamitra_test automatically.
MONGO_URI=mongodb://localhost:27017

# Production Mongo URI example (Atlas):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pustakamitra?retryWrites=true

# Secret used to hash session ids before storing them in Mongo (>= 32 random bytes).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_HASH_KEY=CHANGE-ME-to-a-long-random-string

# Session lifetime in minutes (HTTP-only cookie + Mongo TTL).
SESSION_TTL_MIN=180

# "1" when served over HTTPS in production (sets Secure on cookies).
SECURE_COOKIES=

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
